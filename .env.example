# Copy to .env and edit. All values are optional; the defaults work as-is.
# Directory containing the camera folders. The default reads footage beside
# compose.yaml. Use ".." when this repository is a child of the footage folder.
NVR_DATA_DIR=.

# Optional comma-separated Scrypted stores inside NVR_DATA_DIR. This permits
# browsing multiple untouched archives through one viewer.
NVR_ARCHIVE_DIRS=.

# Merge camera IDs from different stores when session.json records the same IP.
# Keep false unless the selected archives came from the same physical cameras.
NVR_GROUP_CAMERAS_BY_IP=false

# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the local network
# (no authentication — only on a network you trust).
NVR_BIND=127.0.0.1
NVR_PORT=8787

# Should match the cameras' timezone; days and filenames are local time.
TZ=Europe/Rome

# Length of each generated clip, in seconds.
NVR_CLIP_SECONDS=300

# RAM-backed working area used for the in-memory index, JIT clips and previews.
# Nothing under /cache persists when the viewer container is removed.
NVR_CACHE_TMPFS_SIZE=2g

# Generated MP4 budget within that working area (oldest clips evicted first).
# Keep this below NVR_CACHE_TMPFS_SIZE so there is room for previews and index.
NVR_CACHE_LIMIT_GB=1.5

# Friendly names for cameras not in the built-in map.
# NVR_CAMERA_NAMES=scrypted-31=Garage,scrypted-33=Gate

# Seconds between scrub preview frames. Smaller = finer scrubbing and more RAM.
NVR_THUMB_BUCKET=60

# Preview warming: off | day | all. "day" warms the selected day into volatile
# RAM; it never creates persistent cache files beside the footage.
NVR_WARM=day

# Pause between warming batches. Raise it to be gentler on a busy disk.
NVR_WARM_DELAY_MS=250
