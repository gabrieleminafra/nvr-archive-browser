# Copy to .env and edit. All values are optional; the defaults work as-is.
# Directory containing the camera folders. The default reads footage beside
# compose.yaml. Use ".." when this repository is a child of the footage folder.
NVR_DATA_DIR=.

# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the local network
# (no authentication — only on a network you trust).
NVR_BIND=127.0.0.1
NVR_PORT=8787

# Should match the cameras' timezone; days and filenames are local time.
TZ=Europe/Rome

# Length of each generated clip, in seconds.
NVR_CLIP_SECONDS=300

# Disk budget for cached clips and thumbnails, in GB (oldest evicted first).
NVR_CACHE_LIMIT_GB=8

# Friendly names for cameras not in the built-in map.
# NVR_CAMERA_NAMES=scrypted-31=Garage,scrypted-33=Gate

# Seconds between scrub preview frames. Smaller = finer scrubbing, more disk
# and a longer first-run warm-up.
NVR_THUMB_BUCKET=60

# Preview warming: off | day | all.
#   day - warm the day you open (default)
#   all - also warm the entire archive at startup, once
#   off - decode previews only when hovered
# Warming is real disk work. On a mechanical USB drive, keep this at "day" and
# switch to "all" once while nothing else is using the drive.
NVR_WARM=day

# Pause between warming batches. Raise it to be gentler on a busy disk.
NVR_WARM_DELAY_MS=250
